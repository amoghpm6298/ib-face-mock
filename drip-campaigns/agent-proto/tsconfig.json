{
  // `tsc -b` at the repo root only covers `src` (see tsconfig.app.json), and
  // vitest is transpile-only — so without this config the agent-proto
  // sources would never be typechecked at all. Includes src/vite-env.d.ts
  // so the app's own CSS side-effect imports resolve when its modules are
  // pulled in transitively.
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [".", "../src/vite-env.d.ts"]
}
