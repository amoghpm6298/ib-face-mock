# Copy to .env (git-ignored) and fill in your key, then restart `npm run dev`.
# Read ONLY on the server side — never bundled into browser code.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude Sonnet only. Must be a Sonnet model id this key can access.
# Verify with the in-app Knowledge Base > "Verify model" action, which calls
# the Anthropic /v1/models endpoint.
ANTHROPIC_MODEL=claude-sonnet-5
